{% extends 'base.html.twig' %}

{% block title %}Dashboard - Meow List{% endblock %}

{% block body %}
    <div
        class="todo-container"
        data-todo-dashboard
        data-reload-url="{{ path('app_dashboard') }}"
    >
        <div class="todo-header">
            <h1>Meow List</h1>
            <a href="{{ path('app_logout') }}" class="logout-link">Log Out</a>
        </div>

        <form
            id="todo-form"
            class="todo-form"
            method="POST"
            data-create-url="{{ path('app_todo_create') }}"
        >
            <input type="text" id="todo-input" class="todo-input" placeholder="What needs to be done?" required autocomplete="off">
            <button type="submit" id="todo-add-btn" class="todo-add-btn">Add</button>
        </form>

        <ul class="todo-list" id="todo-list">
            {% for todo in todos %}
                <li class="todo-item {% if todo.isDone %}is-done{% endif %}" data-id="{{ todo.id }}">
                    <input type="checkbox" class="todo-checkbox" {% if todo.isDone %}checked{% endif %} data-status-url="{{ path('app_todo_status_change', {'id': todo.id}) }}">
                    <span class="todo-text">{{ todo.text }}</span>
                    <button class="todo-delete-btn" title="Delete" aria-label="Delete" data-delete-url="{{ path('app_todo_delete', {'id': todo.id}) }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                    </button>
                </li>
            {% else %}
                <li class="todo-item empty-message">
                    Your list is empty. Add a task above!
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
