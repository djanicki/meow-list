{% extends 'base.html.twig' %}

{% block title %}Dashboard - Meow List{% endblock %}

{% block body %}
    <style>
        .todo-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 30px;
        }

        .todo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .todo-header h1 {
            font-size: 24px;
            font-weight: 600;
            color: #1a1a1a;
            margin: 0;
        }

        .logout-link {
            color: #dc3545;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: color 0.15s ease-in-out;
        }
        .logout-link:hover {
            color: #bd2130;
            text-decoration: underline;
        }

        .todo-form {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
        }

        .todo-input {
            flex-grow: 1;
            padding: 12px 16px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.2s;
        }

        .todo-input:focus {
            outline: none;
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }

        .todo-add-btn {
            background-color: #0d6efd;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 0 20px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .todo-add-btn:hover {
            background-color: #0b5ed7;
        }
        
        .todo-add-btn:disabled {
            background-color: #8bb9fe;
            cursor: not-allowed;
        }

        .todo-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .todo-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
            transition: background-color 0.2s;
        }

        .todo-item:last-child {
            border-bottom: none;
        }

        .todo-item:hover {
            background-color: #fafafa;
        }

        .todo-checkbox {
            appearance: none;
            -webkit-appearance: none;
            width: 22px;
            height: 22px;
            border: 2px solid #ccc;
            border-radius: 6px;
            margin-right: 15px;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease-in-out;
        }

        .todo-checkbox:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .todo-checkbox:checked::after {
            content: '🐾';
            position: absolute;
            color: white;
            font-size: 16px;
            font-weight: bold;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .todo-text {
            flex-grow: 1;
            font-size: 16px;
            color: #333;
            transition: color 0.3s, text-decoration 0.3s;
        }

        .todo-item.is-done .todo-text {
            color: #adb5bd;
            text-decoration: line-through;
        }

        .todo-delete-btn {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            padding: 8px;
            border-radius: 6px;
            transition: background-color 0.2s;
            opacity: 0.6;
        }

        .todo-item:hover .todo-delete-btn {
            opacity: 1;
        }

        .todo-delete-btn:hover {
            background-color: #fee2e2;
        }

        /* Loading state */
        .todo-item.loading {
            opacity: 0.5;
            pointer-events: none;
        }
    </style>

    <div class="todo-container">
        <div class="todo-header">
            <h1>Meow List</h1>
            <a href="{{ path('app_logout') }}" class="logout-link">Log Out</a>
        </div>

        <form id="todo-form" class="todo-form" method="POST">
            <input type="text" id="todo-input" class="todo-input" placeholder="What needs to be done?" required autocomplete="off">
            <button type="submit" id="todo-add-btn" class="todo-add-btn">Add</button>
        </form>

        <ul class="todo-list" id="todo-list">
            {% for todo in todos %}
                <li class="todo-item {% if todo.isDone %}is-done{% endif %}" data-id="{{ todo.id }}">
                    <input type="checkbox" class="todo-checkbox" {% if todo.isDone %}checked{% endif %} data-status-url="{{ path('app_todo_status_change', {'id': todo.id}) }}">
                    <span class="todo-text">{{ todo.text }}</span>
                    <button class="todo-delete-btn" title="Delete" aria-label="Delete" data-delete-url="{{ path('app_todo_delete', {'id': todo.id}) }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                    </button>
                </li>
            {% else %}
                <li class="todo-item empty-message" style="color: #6c757d; justify-content: center; font-style: italic;">
                    Your list is empty. Add a task above!
                </li>
            {% endfor %}
        </ul>
    </div>

    <script>
        document.addEventListener('turbo:load', () => {
            const form = document.getElementById('todo-form');
            const input = document.getElementById('todo-input');
            const list = document.getElementById('todo-list');
            const addBtn = document.getElementById('todo-add-btn');

            // Handle Add
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = input.value.trim();
                if (!text) return;

                addBtn.disabled = true;
                
                try {
                    const res = await fetch('{{ path("app_todo_create") }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text })
                    });
                    
                    if (res.ok) {
                        // Reload page to show new list (simplest for now without returning inserted ID from backend)
                        // Reload page and bypass cache to show new list
                        window.location.href = window.location.pathname + '?_t=' + new Date().getTime();
                    } else {
                        console.error('Failed to add todo');
                        addBtn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    addBtn.disabled = false;
                }
            });

            // Handle toggle status & delete
            list.addEventListener('click', async (e) => {
                const item = e.target.closest('.todo-item');
                if (!item) return;
                
                const id = item.dataset.id;
                if (!id) return;

                // Toggle status
                if (e.target.classList.contains('todo-checkbox')) {
                    const isDone = e.target.checked;
                    item.classList.toggle('is-done', isDone);
                    item.classList.add('loading');

                    const statusUrl = e.target.dataset.statusUrl;
                    if (!statusUrl) return;

                    try {
                        const res = await fetch(statusUrl, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ isDone })
                        });
                        if (!res.ok) {
                            // Revert on failure
                            e.target.checked = !isDone;
                            item.classList.toggle('is-done', !isDone);
                            console.error('Failed to update status');
                        }
                    } catch (err) {
                        console.error(err);
                        e.target.checked = !isDone;
                        item.classList.toggle('is-done', !isDone);
                    } finally {
                        item.classList.remove('loading');
                    }
                }

                // Delete
                const deleteBtn = e.target.closest('.todo-delete-btn');
                if (deleteBtn) {
                    if (!confirm('Are you sure you want to delete this task?')) return;
                    
                    item.classList.add('loading');
                    
                    const deleteUrl = deleteBtn.dataset.deleteUrl;
                    if (!deleteUrl) return;

                    try {
                        const res = await fetch(deleteUrl, {
                            method: 'DELETE'
                        });
                        if (res.ok) {
                            item.remove();
                            // If list is empty now, we could show empty message
                            if (list.querySelectorAll('.todo-item').length === 0) {
                                window.location.href = window.location.pathname + '?_t=' + new Date().getTime(); // Quick way to show the empty message
                            }
                        } else {
                            console.error('Failed to delete');
                            item.classList.remove('loading');
                        }
                    } catch (err) {
                        console.error(err);
                        item.classList.remove('loading');
                    }
                }
            });
        });
    </script>
{% endblock %}
