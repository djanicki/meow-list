{% extends 'base.html.twig' %}

{% block title %}Welcome - My Checklist{% endblock %}

{% block body %}
    <div class="text-center">
        <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">My Checklist</h1>
        <p style="color: var(--text-muted); margin-bottom: 3rem; font-size: 1.25rem;">Simple, elegant task management.</p>
        
        <div class="flex-col" style="max-width: 300px; margin: 0 auto;">
            <a href="{{ path('app_login') }}" class="btn btn-primary" style="width: 100%">Log In</a>
            <a href="{{ path('app_register') }}" class="btn btn-secondary" style="width: 100%">Create Account</a>
        </div>
    </div>
{% endblock %}
