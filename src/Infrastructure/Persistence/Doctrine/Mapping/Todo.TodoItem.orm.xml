<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="MeowList\Domain\Todo\TodoItem" table="todo_item" repository-class="MeowList\Infrastructure\Persistence\Doctrine\Repository\DoctrineTodoItemRepository">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="userId" type="integer" column="user_id" />
        <field name="text" type="text" />
        <field name="isDone" type="boolean" column="is_done" />
        <field name="createdAt" type="datetime_immutable" column="created_at" />
    </entity>
</doctrine-mapping>
